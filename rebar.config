{erl_opts, [debug_info]}.

{deps, [
    %% Nova + datastar are pre-release, so both are pinned. Nova must stay at
    %% v0.17.0 or later: older routers do not resolve "." and ".." segments
    %% before matching. The streaming SSE return-handler pattern needs
    %% nova#387.
    {nova, {git, "https://github.com/novaframework/nova.git", {tag, "v0.18.3"}}},
    {datastar,
        {git, "https://github.com/Taure/datastar.git",
            {ref, "fcc11f399294b305620a7c99ed633b898ce3889b"}}}
]}.

{project_plugins, [
    {erlfmt, "~>1.7"},
    {rebar3_ex_doc, "~>0.3"}
]}.

{ex_doc, [
    {extras, [<<"README.md">>]},
    {main, <<"readme">>},
    {source_url, <<"https://github.com/novaframework/nova_liveboard">>},
    {homepage_url, <<"https://github.com/novaframework/nova_liveboard">>}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.app.src",
        "src/**/{*.erl, *.hrl}",
        "test/**/{*.erl, *.hrl}"
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{xref_ignores, [
    {kura_repo, config, 1},
    {kura_migrator, status, 1},
    {kura_schema, associations, 1},
    {kura_schema, indexes, 1}
]}.

{dialyzer, [{plt_apps, all_deps}]}.

{overrides, [
    %% redbug (pulled transitively via nova) uses the deprecated `catch`,
    %% which OTP 29 promotes to an error under warnings_as_errors.
    {override, redbug, [{erl_opts, [debug_info, nowarn_deprecated_catch]}]}
]}.
