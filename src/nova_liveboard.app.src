{application, nova_liveboard, [
    {description, "Real-time BEAM VM dashboard for Nova (Nova + Datastar)"},
    {vsn, git},
    {registered, [nova_liveboard_sup, nova_liveboard_tracer, nova_liveboard_poller]},
    {mod, {nova_liveboard_app, []}},
    {applications, [
        kernel,
        stdlib,
        nova,
        datastar
    ]},
    {env, [
        {prefix, "/liveboard"},
        {refresh_ms, 2000},
        {request_buffer, 200},
        {max_streams, 50},
        {max_streams_per_client, 6},
        {stream_lifetime_ms, 300000},
        {redact, standard},
        {trusted_origins, []}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/novaframework/nova_liveboard"}]}
]}.
