{application, nova_liveboard, [
    {description, "Real-time BEAM VM dashboard for Nova (Nova + Datastar)"},
    {vsn, git},
    {registered, [nova_liveboard_tracer]},
    {mod, {nova_liveboard_app, []}},
    {applications, [
        kernel,
        stdlib,
        nova,
        datastar
    ]},
    {env, [
        {prefix, "/liveboard"},
        {refresh_ms, 2000},
        {request_buffer, 200}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/novaframework/nova_liveboard"}]}
]}.
